

classdef SigPreProcessing
    methods(Static)
        %% Get the Leads
        function [conventional_leads, frank_leads] = load_leads(signal)
            conventional_leads = signal(:, 1:12); % Get the first 12 leads
            frank_leads = signal(:, 13:15); % Get the 3 leads, 13,14 and 15 (15=columns of the matriz)
        end

        %% Prepare to plot the comparison for all leads

        function [] = plot_and_compare_leads(descrip, patient, signal_10s,signal_normal,num_leads)
            % Prepare to plot the comparison for all leads
            for lead = 1:num_leads
                % =========================================================================
                fprintf('%s -> Sinal %s. Média da Lead %d: %.4f (Deve ser ~0)\n', descrip, upper(patient), lead, mean(signal_normal(:,lead)));
                fprintf('%s -> Energia da Lead %d: %.4f (Deve ser 1)\n', upper(patient), lead, sum(signal_normal(:,lead).^2));
        
                figure;
                subplot(2,1,1); plot(signal_10s(:,lead)); title(sprintf('%s -> Original Signal (10s) - Lead %d', upper(strrep(patient, '_','.')), lead));
                subplot(2,1,2); plot(signal_normal(:,lead)); title(sprintf('%s -> %s signal (Eq. 1) - Lead %d', upper(strrep(patient, '_','.')), descrip, lead));
            end
        end
        %%  Load the diagnose of the patient from .hea file 
        
        function [patient_diagnose_label, fid] = load_patient_diagnose(recordName, key_word, flag)
        
            fid = fopen([recordName, '.hea'], 'r');
            % Check if the file was opened
            if fid == -1
                error('Failed to read .hea file');
            end
        
            patient_diagnose_label ='unknow';
            
            while ~feof(fid)
                tline = strtrim(fgetl(fid));
                % Look for the line that contains the clinical classification
                % In PTB it usually appears as: "# clinical classification: Myocardial infarction"
            
                % Check if the line contains the specified keyword for diagnosis
                % 'Reason for admission' is the keyword we are looking for in the .hea file
                % 'IgnoreCase' is a flag that allows the search to be case insensitive
                if contains(tline, key_word, flag, true)
                    % Extract the text only after : points
                    parts = split(tline, ':');
                    
                    fprintf('Parts found: %d\n', length(parts)); 
                    
                    if length(parts) >= 2
                        patient_diagnose_label = strtrim(parts{2}); % Extract and trim the diagnosis label from the line
                    end
                    break;
                end
            end
        
            fclose(fid); % Close the file
        end
        
        %%
        
        function [numSamples,numLeads,desired_samples,total_seconds] = calculate_seconds(signal, Fs)
            [numSamples,numLeads] = size(signal); % Get the number of samples and leads from the signal
            
            % Get the total of seconds and use round function to format the scientific
            % value 3.840000e+01
            total_seconds = round(numSamples / Fs);
            
            % 2. Crop to match the article (Only the first 10s)
            % 10 seconds * 1000 samples/second = 10000 samples
            desired_samples = 10 * Fs;
        end
        
        
        %% Splite the sample into 10 seconds
        function [signal_10s] = splite_sample_int_10_seconds(signal, desired_samples)
            % Split the signal into segments of 10 seconds
            if size(signal, 1) >= desired_samples
                signal_10s = signal(1: desired_samples,:);
                fprintf('Splited signal to 10 seconds (10000 samples)\n');
            else
                warning('This signal has less than 10 seconds!');
                signal_10s = signal;
            end
        end

        %% Normalize the signal
        function [normalized_signal] = normalize_signal(signal)
            normalized_signal = (signal - min(signal)) ./ (max(signal) - min(signal)); % Min-max normalization
        end

        % Start the signal normalization for each lead
        function [signal_normal, lead_final] = normalize_signal_simple(signal_normal,signal_10s, numLeads)
            % the process is done LEAD per LEAD (Column per Column)
            for i = 1: numLeads
                lead = signal_10s(:, i); % Get the current lead
            
                % Remove the Mean (Zero-Mean
                lead_centered = lead - mean(lead);
            
                % Normalization of the power using the equation from the article
                % x(n) = lead(n) / sqrt(x^2);
                energy = sum(lead_centered .^2);
            
                % Avoid division by zero (if the signal is straight line)
                if energy > 0
                    lead_final = lead_centered / sqrt(energy);
                else
                    lead_final = lead_centered;
                end
            
                % Store into the final signal
                signal_normal(:, i) = lead_final;
            
            end
        end

        %% Lowpass Filtering  
        function [signal_normal] = lowpass_filter(signal_normal, signal_10s, numLeads, LowPass01)

            % Get the Numerator (B) and Denominator (A) coefficients from the filter object.
            % B is the feedforward vector (used as the first argument in 'filter').
            % A is the feedback vector (used as the second argument in 'filter').
            [B, A] = tf(LowPass01); 

            % Inicializar uma matriz para armazenar o sinal filtrado
            %numSamples = size(signal_normal, 1);
            %signal_filtered = zeros(numSamples, numLeads);
        
            % The process is done LEAD per LEAD (Column per Column)
            for i = 1: numLeads
                lead = signal_10s(:, i); % Get the current lead
                
                % Apply the filter: output = filter(B, A, input)
                signal_normal(:, i) = filter(B, A, lead);
            end
        end
        %% Bandpass filtering
        function [signal_normal] = bandpass_filter(signal_normal, signal_10s, numLeads, BandPass_ECG)

            % 1. Obter os coeficientes do novo filtro Bandpass
            % [B] = Numerador (feedforward), [A] = Denominador (feedback)
            % A função 'tf' (Transfer Function) é usada para extrair os vetores B e A do objeto.
            [B_bandpass, A_bandpass] = tf(BandPass_ECG); 
        
            % Inicializar uma matriz para armazenar o sinal filtrado
            %N_amostras = size(signal_input, 1);
            %signal_filtered = zeros(N_amostras, numLeads); 
        
            % 2. Aplicar o filtro LEAD por LEAD (Coluna por Coluna)
            for i = 1: numLeads
                lead = signal_10s(:, i); % Extrair a Lead atual
                
                % Aplica o filtro Bandpass: output = filter(B, A, input)
                signal_normal(:, i) = filter(B_bandpass, A_bandpass, lead);
            end
        end

        %% Bandstop filtering substituting Notch
        function [signal_normal] = bandpass_filter(signal_normal, signal_10s, numLeads, BandPass_ECG)

            % 1. Obter os coeficientes do novo filtro Bandpass
            % [B] = Numerador (feedforward), [A] = Denominador (feedback)
            % A função 'tf' (Transfer Function) é usada para extrair os vetores B e A do objeto.
            [B_bandpass, A_bandpass] = tf(BandPass_ECG); 
        
            % Inicializar uma matriz para armazenar o sinal filtrado
            %N_amostras = size(signal_input, 1);
            %signal_filtered = zeros(N_amostras, numLeads); 
        
            % 2. Aplicar o filtro LEAD por LEAD (Coluna por Coluna)
            for i = 1: numLeads
                lead = signal_10s(:, i); % Extrair a Lead atual
                
                % Aplica o filtro Bandpass: output = filter(B, A, input)
                signal_normal(:, i) = filter(B_bandpass, A_bandpass, lead);
            end
        end




    end % EndMethods
end % EndClass